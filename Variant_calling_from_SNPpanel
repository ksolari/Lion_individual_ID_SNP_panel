###Map data to the reference genome
bwa mem -t 16 ../Lion_SNPcalls/lion_hap2X_out_JBAT_nov18.debris.reorder2_hap1Yadd.FINAL.fa Run1_R1_001.fastq.gz Run1_R2_001.fastq.gz | samtools view -bS - | samtools sort - > Run1_sorted.bam

###remove reads that have a mapping quality (MQ) less than 1
samtools view -h -q 1 Run1_sorted.bam -o Run1_sorted_MQ1.bam
samtools index Run1_sorted_MQ1.bam

###Filter bam to only include the target amplicon regions
bedtools intersect -a Run1_sorted_MQ1.bam -b Lion_SNP_Amp_Blocks.bed > Run1_sorted_MQ1_AmpliconOnly.bam
samtools index Run1_sorted_MQ1_AmpliconOnly.bam

###Genotype target SNP and one bp before and after
bcftools mpileup -A -a AD,DP -R Lion_SNPs_3bp.bed -d 10000 -f ../Lion_SNPcalls/lion_hap2X_out_JBAT_nov18.debris.reorder2_hap1Yadd.FINAL.fa -b ALL_runs_bamList.txt  | bcftools call -m -Oz -f GQ -o SNPcalls_3bp.vcf

###Filter vcf to only include target SNPs
vcftools --vcf SNPcalls_3bp.vcf --out SNPcalls_3bp_1bp --bed Lion_SNPs_1bp.bed --recode

###Filter genotypes to only retain ones with a depth of 15 or more and a genotype quality of 20 or greater
vcftools --vcf Lion_SNPs_1bp.recode.vcf --out Lion_SNPs_1bp_minDP15minGQ20 --minDP 15 --minGQ 20 --recode

